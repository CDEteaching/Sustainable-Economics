{"scoreShow": "Check", "submit": "Submit", "tryAgain": "Retry", "scoreExplanation": "Correct answers give +1 point. Incorrect answers give -1 point. The lowest possible score is 0.", "question": {"settings": {"size": {"width": 700, "height": 700}}, "task": {"elements": [{"x": 3.0721966205837177, "y": 66.5, "width": 23.94, "height": 1.25, "dropZones": ["0", "1"], "type": {"library": "H5P.AdvancedText 1.1", "params": {"text": "<p><span style=\"font-size:0.75em\">Lost biodiversity can be compensated by technological capital.</span></p>\n"}, "subContentId": "694615b1-c393-4093-92de-7120270a93fa", "metadata": {"contentType": "Text", "license": "U", "title": "Untitled Text", "authors": [], "changes": []}}, "backgroundOpacity": 100, "multiple": false}, {"x": 3.0721966205837177, "y": 70.5, "width": 22.46, "height": 1.25, "dropZones": ["0", "1"], "type": {"library": "H5P.AdvancedText 1.1", "params": {"text": "<p><span style=\"font-size:0.75em\">Natural capital is only substitutable to a limited extent.</span></p>\n"}, "subContentId": "01dc3317-9375-4bbe-9510-68c5897528dc", "metadata": {"contentType": "Text", "license": "U", "title": "Untitled Text", "authors": [], "changes": []}}, "backgroundOpacity": 100, "multiple": false}, {"x": 3.0721966205837177, "y": 74.5, "width": 22.09, "height": 1.25, "dropZones": ["0", "1"], "type": {"library": "H5P.AdvancedText 1.1", "params": {"text": "<p><span style=\"font-size:0.75em\">Monetary valuation makes all types of capital comparable.</span></p>\n"}, "subContentId": "3d0ef0e7-856f-4727-94d3-0d38407e4f9b", "metadata": {"contentType": "Text", "license": "U", "title": "Untitled Text", "authors": [], "changes": []}}, "backgroundOpacity": 100, "multiple": false}, {"x": 3.0721966205837177, "y": 78.5, "width": 19.13, "height": 1.25, "dropZones": ["0", "1"], "type": {"library": "H5P.AdvancedText 1.1", "params": {"text": "<p><span style=\"font-size:0.75em\">The economy is a subsystem of a finite ecosystem.</span></p>\n"}, "subContentId": "e841aec8-bd74-4262-8d75-49f48968a0b2", "metadata": {"contentType": "Text", "license": "U", "title": "Untitled Text", "authors": [], "changes": []}}, "backgroundOpacity": 100, "multiple": false}, {"x": 3.0721966205837177, "y": 82.5, "width": 23.57, "height": 1.25, "dropZones": ["0", "1"], "type": {"library": "H5P.AdvancedText 1.1", "params": {"text": "<p><span style=\"font-size:0.75em\">What matters is that total capital and welfare are passed on.</span></p>\n"}, "subContentId": "8d37d840-bf61-430a-bf60-5ba956ce54f2", "metadata": {"contentType": "Text", "license": "U", "title": "Untitled Text", "authors": [], "changes": []}}, "backgroundOpacity": 100, "multiple": false}, {"x": 3.0721966205837177, "y": 86.5, "width": 25.05, "height": 1.25, "dropZones": ["0", "1"], "type": {"library": "H5P.AdvancedText 1.1", "params": {"text": "<p><span style=\"font-size:0.75em\">Prevention and anticipation rather than remediation and reaction.</span></p>\n"}, "subContentId": "c9234bf9-0ae9-4f81-9318-04b4b4968a01", "metadata": {"contentType": "Text", "license": "U", "title": "Untitled Text", "authors": [], "changes": []}}, "backgroundOpacity": 100, "multiple": false}, {"x": 3.0721966205837177, "y": 90.5, "width": 28.01, "height": 1.25, "dropZones": ["0", "1"], "type": {"library": "H5P.AdvancedText 1.1", "params": {"text": "<p><span style=\"font-size:0.75em\">Coal extraction is defensible if the revenue builds manufactured capital.</span></p>\n"}, "subContentId": "ec25acbf-34a5-464a-a565-2d0451d036b0", "metadata": {"contentType": "Text", "license": "U", "title": "Untitled Text", "authors": [], "changes": []}}, "backgroundOpacity": 100, "multiple": false}, {"x": 3.0721966205837177, "y": 94.5, "width": 19.87, "height": 1.25, "dropZones": ["0", "1"], "type": {"library": "H5P.AdvancedText 1.1", "params": {"text": "<p><span style=\"font-size:0.75em\">Geoengineering treats the symptoms, not the causes.</span></p>\n"}, "subContentId": "f07d8e8e-6882-4d03-894c-be0408124f94", "metadata": {"contentType": "Text", "license": "U", "title": "Untitled Text", "authors": [], "changes": []}}, "backgroundOpacity": 100, "multiple": false}], "dropZones": [{"x": 4.6082949308755765, "y": 6.144393241167435, "width": 38.75, "height": 11.25, "correctElements": ["0", "2", "4", "6"], "showLabel": true, "backgroundOpacity": 100, "tipsAndFeedback": {"tip": ""}, "single": false, "autoAlign": false, "type": {"library": "H5P.DragQuestionDropzone 0.1"}, "label": "<div>Weak sustainability (neoclassical)</div>\n"}, {"x": 4.6082949308755765, "y": 38.40245775729647, "width": 38.75, "height": 11.25, "correctElements": ["1", "2", "3", "5", "7"], "showLabel": true, "backgroundOpacity": 100, "tipsAndFeedback": {"tip": "Not every statement belongs to only one side. Think about whether a statement is a position held by one view or a point the other view argues against."}, "single": false, "autoAlign": false, "type": {"library": "H5P.DragQuestionDropzone 0.1"}, "label": "<div>Strong sustainability (ecological economics)</div>\n"}]}}, "overallFeedback": [{"from": 0, "to": 100, "feedback": "The key question is substitutability. Weak sustainability assumes that natural capital can in principle be replaced by manufactured or human capital, as long as total capital is maintained. Strong sustainability regards natural capital as only partly substitutable and relies on prevention rather than compensation."}], "behaviour": {"enableRetry": true, "enableCheckButton": true, "singlePoint": false, "applyPenalties": true, "enableScoreExplanation": true, "dropZoneHighlighting": "never", "autoAlignSpacing": 2, "enableFullScreen": false, "showScorePoints": true, "showTitle": true}, "grabbablePrefix": "Grabbable {num} of {total}.", "grabbableSuffix": "Placed in dropzone {num}.", "dropzonePrefix": "Dropzone {num} of {total}.", "noDropzone": "No dropzone.", "tipLabel": "Show tip.", "tipAvailable": "Tip available", "correctAnswer": "Correct answer", "wrongAnswer": "Wrong answer", "feedbackHeader": "Feedback", "scoreBa